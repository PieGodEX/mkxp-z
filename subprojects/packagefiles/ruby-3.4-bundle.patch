# Prevents Ruby's build system from adding `-bundle_loader` to the linker flags in macOS builds.
# This linker flag is only supposed to be added if Ruby is configured without `--with-static-linked-ext`,
# but due to a bug in the build system, it gets added even if configured with `--with-static-linked-ext`.

--- a/configure.ac
+++ b/configure.ac
@@ -3166,7 +3166,7 @@ AC_SUBST(EXTOBJS)
 			: ${PRELOADENV=DYLD_INSERT_LIBRARIES}
                         AS_IF([test x"$enable_shared" = xyes], [
                             # Resolve symbols from libruby.dylib in $(LIBS) when --enable-shared
-                        ], [test "x$EXTSTATIC" = x], [
+                        ], [false], [
                             # When building exts as bundles, a mach-o bundle needs to know its loader
                             # program to bind symbols from the ruby executable
                             EXTDLDFLAGS="-bundle_loader '\$(BUILTRUBY)'"
